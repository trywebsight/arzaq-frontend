# Public site origin (canonicals, sitemap, og:image).
# Prefer SITE_URL at container runtime; NEXT_PUBLIC_SITE_URL is inlined at build.
# When both are unset, code falls back to http://localhost:3000 — see lib/site.ts.
SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API origin — used only when mock mode is off. Example: https://api.example.com
# Trailing slash is stripped. Required for live mode; empty + mocks off throws.
NEXT_PUBLIC_API_URL=

# Preferred mock switch: true = fixtures in mocks/; false = HTTP to NEXT_PUBLIC_API_URL.
# When true, mocks win even if NEXT_PUBLIC_API_URL is set.
# When unset (and USE_MOCKS also unset), mocks default ON for local DX.
NEXT_PUBLIC_MOCK_MODE=true

# Legacy alias of NEXT_PUBLIC_MOCK_MODE (still read when MOCK_MODE is unset).
# NEXT_PUBLIC_USE_MOCKS=true

# Optional media CDN hostname (or full origin) for next/image remotePatterns,
# when images are not hosted on NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_MEDIA_HOST=cdn.example.com

# Artificial latency for the mock branch, in milliseconds.
NEXT_PUBLIC_MOCK_DELAY=350

# Force a data state globally: ok | loading | error | empty | slow
# Per page load, the `?mockState=` query parameter overrides this.
NEXT_PUBLIC_MOCK_STATE=ok
