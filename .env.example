# Public site origin (canonicals, sitemap, og:image).
# Prefer SITE_URL at container runtime (no rebuild). NEXT_PUBLIC_SITE_URL is a
# build-time / local fallback when SITE_URL is unset.
# When both are unset, code falls back to http://localhost:3000 — see lib/site.ts.
SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API origin — used only when mock mode is off. Example: https://api.example.com
# Trailing slash is stripped. Required for live mode; empty + mocks off throws.
# Runtime (Docker/Dokploy): set API_URL or NEXT_PUBLIC_API_URL — restart only.
API_URL=
NEXT_PUBLIC_API_URL=

# Preferred mock switch: true = fixtures in mocks/; false = HTTP to API_URL.
# When true, mocks win even if API_URL is set.
# When unset (and USE_MOCKS also unset), mocks default ON for local DX.
# Runtime (Docker/Dokploy): set MOCK_MODE or NEXT_PUBLIC_MOCK_MODE — restart only.
MOCK_MODE=
NEXT_PUBLIC_MOCK_MODE=true

# Legacy alias of MOCK_MODE / NEXT_PUBLIC_MOCK_MODE (still read when those unset).
# USE_MOCKS=
# NEXT_PUBLIC_USE_MOCKS=true

# Optional media CDN hint (docs / narrower remotePatterns). next/image already
# allows any http(s) host via hostname "**" in next.config.ts, so changing the
# CDN at runtime does not require a rebuild for Image optimization.
# Example: MEDIA_HOST=https://images.unsplash.com/
# MEDIA_HOST=
# NEXT_PUBLIC_MEDIA_HOST=

# Artificial latency for the mock branch, in milliseconds.
MOCK_DELAY=
NEXT_PUBLIC_MOCK_DELAY=350

# Force a data state globally: ok | loading | error | empty | slow
# Per page load, the `?mockState=` query parameter overrides this.
MOCK_STATE=
NEXT_PUBLIC_MOCK_STATE=ok

# Swap navbar / footer / OG logos for the Websight demo marks.
# Runtime (Docker/Dokploy): set DEMO_MODE or NEXT_PUBLIC_DEMO_MODE — restart only.
DEMO_MODE=
# NEXT_PUBLIC_DEMO_MODE=true
